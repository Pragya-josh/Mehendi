@{
    ViewData["Title"] = "Gallery";
}

<!-- Page Banner -->
<section class="page-banner">
    <div class="container text-center position-relative">
        <span class="section-badge" style="background:rgba(201,151,59,0.2); border-color:rgba(201,151,59,0.4); color:var(--gold-light);">✦ Our Portfolio ✦</span>
        <h1 class="page-banner-title mt-3">Mehendi Gallery</h1>
        <p style="color:rgba(245,226,181,0.75); font-size:1rem; margin-bottom:1.5rem;">Explore our curated collection of breathtaking mehendi designs</p>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-mehendi justify-content-center">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active">Gallery</li>
            </ol>
        </nav>
    </div>
    <!-- Decorative SVG circles -->
    <div style="position:absolute; right:-80px; top:-80px; width:300px; height:300px; border-radius:50%; border:2px solid rgba(201,151,59,0.15); pointer-events:none;"></div>
    <div style="position:absolute; left:-60px; bottom:-60px; width:200px; height:200px; border-radius:50%; border:2px solid rgba(201,151,59,0.1); pointer-events:none;"></div>
</section>

<!-- Filter Buttons -->
<section style="padding: 3rem 0 1rem; background:var(--cream);">
    <div class="container text-center">
        <div class="d-flex flex-wrap justify-content-center gap-2" id="filterButtons">
            <button class="gallery-filter-btn active" data-filter="all" onclick="filterGallery('all',this)">
                <i class="bi bi-grid-3x3-gap me-1"></i> All Designs
            </button>
            <button class="gallery-filter-btn" data-filter="bridal" onclick="filterGallery('bridal',this)">
                <i class="bi bi-gem me-1"></i> Bridal
            </button>
            <button class="gallery-filter-btn" data-filter="arabic" onclick="filterGallery('arabic',this)">
                <i class="bi bi-flower1 me-1"></i> Arabic
            </button>
            <button class="gallery-filter-btn" data-filter="mandala" onclick="filterGallery('mandala',this)">
                <i class="bi bi-circle-square me-1"></i> Mandala
            </button>
            <button class="gallery-filter-btn" data-filter="feet" onclick="filterGallery('feet',this)">
                <i class="bi bi-wind me-1"></i> Feet & Back
            </button>
            <button class="gallery-filter-btn" data-filter="simple" onclick="filterGallery('simple',this)">
                <i class="bi bi-brush me-1"></i> Simple & Minimal
            </button>
        </div>
    </div>
</section>

