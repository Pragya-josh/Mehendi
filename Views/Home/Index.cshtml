<!-- ===================== GALLERY PREVIEW ===================== -->
<section style="padding: 6rem 0; background: #F9F1E8;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge" data-anim="fade">✦ Portfolio ✦</span>
            <h2 class="section-title" data-anim>Our Finest Creations</h2>
            <p class="section-subtitle" data-anim data-delay="100">A glimpse into our world of intricate henna artistry</p>
            <div class="ornament-divider" data-anim data-delay="150"><span>✿</span></div>
        </div>
        <div class="row g-3">
            <div class="col-md-4 col-6" data-anim data-delay="0">
                <div class="gallery-item" onclick="openLightbox('/images/bridal_arm.jpg','Bridal Full Arm Mehendi')">
                    <img src="/images/bridal_arm.jpg" alt="Bridal Full Arm Mehendi" loading="lazy"/>
                    <div class="gallery-overlay">
                        <div class="gallery-overlay-content">
                            <h5>Bridal Full Arm</h5>
                            <p>Traditional Indian Bridal</p>
                        </div>
                    </div>
                    <div class="gallery-overlay-icon"><i class="bi bi-zoom-in"></i></div>
                </div>
            </div>
            <div class="col-md-4 col-6" data-anim data-delay="100">
                <div class="gallery-item" onclick="openLightbox('/images/arabic.jpg','Arabic Mehendi Design')">
                    <img src="/images/arabic.jpg" alt="Arabic Mehendi Design" loading="lazy"/>
                    <div class="gallery-overlay">
                        <div class="gallery-overlay-content">
                            <h5>Arabic Floral</h5>
                            <p>Elegant Arabic Style</p>
                        </div>
                    </div>
                    <div class="gallery-overlay-icon"><i class="bi bi-zoom-in"></i></div>
                </div>
            </div>
            <div class="col-md-4 col-6" data-anim data-delay="200">
                <div class="gallery-item" onclick="openLightbox('/images/mandala.jpg','Mandala Mehendi')">
                    <img src="/images/mandala.jpg" alt="Mandala Mehendi" loading="lazy"/>
                    <div class="gallery-overlay">
                        <div class="gallery-overlay-content">
                            <h5>Mandala Art</h5>
                            <p>Geometric Mandala Pattern</p>
                        </div>
                    </div>
                    <div class="gallery-overlay-icon"><i class="bi bi-zoom-in"></i></div>
                </div>
            </div>
            <div class="col-md-4 col-6" data-anim data-delay="100">
                <div class="gallery-item" onclick="openLightbox('/images/feet.jpg','Feet Mehendi Design')">
                    <img src="/images/feet.jpg" alt="Feet Mehendi Design" loading="lazy"/>
                    <div class="gallery-overlay">
                        <div class="gallery-overlay-content">
                            <h5>Bridal Feet</h5>
                            <p>Indo-Western Fusion</p>
                        </div>
                    </div>
                    <div class="gallery-overlay-icon"><i class="bi bi-zoom-in"></i></div>
                </div>
            </div>
            <div class="col-md-8" data-anim data-delay="200" style="max-height:none;">
                <div class="gallery-item" style="aspect-ratio:16/9;" onclick="openLightbox('/images/ceremony.jpg','Mehendi Ceremony Setup')">
                    <img src="/images/ceremony.jpg" alt="Mehendi Ceremony Setup" loading="lazy" style="aspect-ratio:16/9;"/>
                    <div class="gallery-overlay">
                        <div class="gallery-overlay-content">
                            <h5>Mehendi Ceremony</h5>
                            <p>Full Event Decoration & Setup</p>
                        </div>
                    </div>
                    <div class="gallery-overlay-icon"><i class="bi bi-zoom-in"></i></div>
                </div>
            </div>
        </div>
        <div class="text-center mt-5" data-anim>
            <a href="/Gallery" class="btn-gold">
                <i class="bi bi-grid-3x3-gap"></i> View Full Gallery
            </a>
        </div>
    </div>
</section>

<!-- ===================== FEATURED SERVICE ===================== -->
