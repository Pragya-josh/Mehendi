                    <div class="feature-icon" style="background: #8D4B4B; color: white; width: 60px; height: 60px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; box-shadow: 0 10px 20px rgba(141,75,75,0.3);">
