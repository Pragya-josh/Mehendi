                        <p style="color: #666; font-size: 0.95rem; margin-bottom: 0;">Stunning Mehandi at pocket-friendly rates</p>
                    </div>
                    <div class="feature-icon" style="background: #8D4B4B; color: white; width: 60px; height: 60px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; box-shadow: 0 10px 20px rgba(141,75,75,0.3);">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>

                <div class="feature-item d-flex align-items-center justify-content-end text-end" data-anim="left" data-delay="200">
                    <div class="feature-text me-3">
