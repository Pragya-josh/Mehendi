                            <i class="bi bi-check-circle-fill" style="color:var(--gold); font-size:1.2rem;"></i>
                            <span style="font-size:0.9rem; font-weight:500; color:var(--text-dark);">Home Service</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px; padding:12px 16px; background:var(--white); border-radius:12px; border:1px solid rgba(201,151,59,0.15); box-shadow:0 4px 15px rgba(0,0,0,0.05);">
                            <i class="bi bi-check-circle-fill" style="color:var(--gold); font-size:1.2rem;"></i>
                            <span style="font-size:0.9rem; font-weight:500; color:var(--text-dark);">Event Bookings</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px; padding:12px 16px; background:var(--white); border-radius:12px; border:1px solid rgba(201,151,59,0.15); box-shadow:0 4px 15px rgba(0,0,0,0.05);">
