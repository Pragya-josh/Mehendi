@{
    ViewData["Title"] = "Home";
}

<!-- ===================== HERO SECTION ===================== -->
<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="row align-items-center min-vh-100 py-5">
            <div class="col-lg-6 hero-content">
                <div class="hero-badge">
                    <i class="bi bi-stars me-2"></i>Award Winning Pawan Mehendi Artist
                </div>
                <h1 class="hero-title">
                    Where Art Meets
                    <span class="accent">
                        <span class="accent-script">Tradition</span>
                    </span>
                </h1>
                <p class="hero-description">
                    Experience the timeless beauty of mehendi art — each intricate design woven with love, skill, and centuries of cultural heritage. Perfect for weddings, festivals & every celebration.
                </p>
                <div class="hero-buttons d-flex flex-wrap gap-3">
                    <a href="/Gallery" class="btn-gold">
                        <i class="bi bi-images"></i> View Gallery
                    </a>
                    <a href="/Contact" class="btn-outline-gold">
                        <i class="bi bi-calendar-heart"></i> Book Appointment
                    </a>
                </div>
                <div class="hero-stats">
                    <div class="hero-stat">
                        <div class="number" data-count="1200" data-suffix="+">0+</div>
                        <div class="label">Brides Adorned</div>
                    </div>
                    <div class="hero-stat">
                        <div class="number" data-count="12" data-suffix="+">0+</div>
                        <div class="label">Years Experience</div>
                    </div>
                    <div class="hero-stat">
                        <div class="number" data-count="98" data-suffix="%">0%</div>
                        <div class="label">Happy Clients</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-flex justify-content-center">
                <div class="hero-image-wrap">
                    <!-- Animated Photo Slider -->
                    <div class="hero-slider-container">
                        <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3500">
                            <div class="carousel-inner" style="border-radius: 40px; box-shadow: 0 20px 50px rgba(0,0,0,0.3); border: 4px solid var(--gold-light);">
                                <div class="carousel-item active">
                                    <img src="/images/m2.jpg" class="d-block w-100" style="height: 420px; object-fit: cover; border-radius: 36px;" alt="Bridal Pawan Mehendi Art 1">
                                </div>
                                <div class="carousel-item">
                                    <img src="/images/m1.jpg" class="d-block w-100" style="height: 420px; object-fit: cover; border-radius: 36px;" alt="Bridal Pawan Mehendi Art 2">
                                </div>
                                <div class="carousel-item">
                                    <img src="/images/mehendi.jpg" class="d-block w-100" style="height: 420px; object-fit: cover; border-radius: 36px;" alt="Bridal Pawan Mehendi Art 3">
                                </div>
                                <div class="carousel-item">
                                    <img src="/images/feet.jpg" class="d-block w-100" style="height: 420px; object-fit: cover; border-radius: 36px;" alt="Bridal Pawan Mehendi Art 4">
                                </div>
                            </div>
                            <!-- Optional Navigation Controls -->
                            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="opacity: 0;">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="opacity: 0;">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>
                    <!-- Floating badges -->
                    <div class="floating-element" style="position:absolute; top:10%; right:-5%;">
                        <div class="float-badge"><i class="bi bi-gem me-1" style="color:#C9973B;"></i>Bridal Expert</div>
                    </div>
                    <div class="floating-element" style="position:absolute; bottom:15%; left:-10%;">
                        <div class="float-badge"><i class="bi bi-award me-1" style="color:#C9973B;"></i>100% Natural</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Scroll indicator -->
    <div style="position:absolute; bottom:30px; left:50%; transform:translateX(-50%); text-align:center; animation:fadeInUp 1s ease 1.5s both;">
        <div style="color:rgba(201,151,59,0.7); font-size:0.8rem; letter-spacing:2px; text-transform:uppercase; margin-bottom:8px;">Scroll</div>
        <div style="width:1px; height:40px; background:linear-gradient(to bottom, rgba(201,151,59,0.7), transparent); margin:0 auto; animation:scrollLine 2s ease-in-out infinite;"></div>
    </div>
</section>

<!-- ===================== WHY CHOOSE US ===================== -->
<section class="py-6 why-choose-us-section" style="padding: 6rem 0; background: #EAF7E3; overflow: hidden;">
